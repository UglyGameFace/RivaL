ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io
ODDSPAPI_QUOTA_RESERVE=20
ODDSPAPI_ACCOUNT_CACHE_SECONDS=60
SPORTSGAMEODDS_API_KEY=
SPORTSGAMEODDS_BASE_URL=https://api.sportsgameodds.com/v2
SPORTSGAMEODDS_MONTHLY_ENTITY_RESERVE=250
RIVAL_CURRENT_LEAGUES=NBA,NFL
RIVAL_CURRENT_BOOKMAKERS=draftkings,fanduel
RIVAL_CURRENT_REFRESH_SECONDS=600
RIVAL_CURRENT_EVENT_LIMIT=25
RIVAL_CURRENT_MAX_PAGES=1

# Production storage. Use the private PostgreSQL URL issued by the Discloud database template.
RIVAL_STORAGE_BACKEND=postgres
RIVAL_DATABASE_URL=

# Local/test compatibility only. Ignored while RIVAL_STORAGE_BACKEND=postgres.
RIVAL_DB_PATH=data/rival.sqlite
DISCORD_TOKEN=
RIVAL_DEV_GUILD_ID=

# Automatically collect read-only perpetuals every five minutes on Discloud PostgreSQL.
# Turn off only for maintenance or if the deployment cannot reach permitted public feeds.
RIVAL_PERP_COLLECTION_ENABLED=true
RIVAL_PERP_COLLECTION_ASSETS=BTC,ETH,SOL
RIVAL_PERP_COLLECTION_SECONDS=300
RIVAL_PERP_COLLECTION_BARS=48

# Google Drive cold warehouse.
# Values are private deployment configuration. Never commit real folder IDs.
RIVAL_DRIVE_ROOT_FOLDER_ID=
RIVAL_DRIVE_HISTORY_FOLDER_ID=
RIVAL_DRIVE_MANIFESTS_FOLDER_ID=
RIVAL_DRIVE_MODELS_FOLDER_ID=
RIVAL_DRIVE_PREDICTIONS_FOLDER_ID=
RIVAL_DRIVE_BACKUPS_FOLDER_ID=
RIVAL_DRIVE_REPORTS_FOLDER_ID=
RIVAL_DRIVE_STAGING_FOLDER_ID=

# Runtime Google OAuth. Store real values only in deployment secret storage.
RIVAL_DRIVE_OAUTH_CLIENT_ID=
RIVAL_DRIVE_OAUTH_CLIENT_SECRET=
RIVAL_DRIVE_OAUTH_REFRESH_TOKEN=
RIVAL_ARCHIVE_ENABLED=false
RIVAL_ARCHIVE_LOCAL_DIR=data/archive-staging
RIVAL_ARCHIVE_CLOSED_STATE_MINUTES=60
RIVAL_ARCHIVE_BATCH_ROWS=25000
RIVAL_ARCHIVE_CHUNK_MIB=8
RIVAL_ARCHIVE_RUN_SECONDS=3600
RIVAL_ARCHIVE_MAX_BATCHES=4

# Opt-in cold copies of immutable historical perpetual candles. Requires the
# shared Drive archive enabled and a verified private OAuth refresh token.
# Does not delete old candles from operational PostgreSQL.
RIVAL_PERP_ARCHIVE_ENABLED=false
RIVAL_PERP_ARCHIVE_KEEP_HOT_DAYS=14
RIVAL_PERP_ARCHIVE_BATCH_ROWS=1000
RIVAL_PERP_ARCHIVE_MAX_BATCHES=2

# Optional second research track: existing Discloud GEMINI_API_KEY or GOOGLE_API_KEY.
# Never paste the actual key into code, GitHub, screenshots or Discord.
RIVAL_GEMINI_MODEL=gemini-3.8-flash
RIVAL_GEMINI_DAILY_MAX=24
RIVAL_GEMINI_COOLDOWN_SECONDS=900

# Independent optional automated research: at most one AI candidate per asset
# every four UTC hours, subject to the SAME persisted quota/circuit breaker.
RIVAL_GEMINI_AUTO_ENABLED=true

# Read-only historical recovery and completed six-month gap audits.
# Each Gate asset fetches at most 600 older 5m bars per cycle; no trading.
RIVAL_HISTORY_RECOVERY_ENABLED=true
RIVAL_HISTORY_RECOVERY_SECONDS=300
RIVAL_HISTORY_AUDIT_ENABLED=true
