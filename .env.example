ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io
ODDSPAPI_QUOTA_RESERVE=20
ODDSPAPI_ACCOUNT_CACHE_SECONDS=60
SPORTSGAMEODDS_API_KEY=
SPORTSGAMEODDS_BASE_URL=https://api.sportsgameodds.com/v2
SPORTSGAMEODDS_MONTHLY_ENTITY_RESERVE=250
RIVAL_CURRENT_LEAGUES=NBA,NFL
RIVAL_CURRENT_BOOKMAKERS=draftkings,fanduel
RIVAL_CURRENT_REFRESH_SECONDS=600
RIVAL_CURRENT_EVENT_LIMIT=25
RIVAL_CURRENT_MAX_PAGES=1

# Production storage. Use the private PostgreSQL URL issued by the Discloud database template.
RIVAL_STORAGE_BACKEND=postgres
RIVAL_DATABASE_URL=

# Local/test compatibility only. Ignored while RIVAL_STORAGE_BACKEND=postgres.
RIVAL_DB_PATH=data/rival.sqlite
DISCORD_TOKEN=
RIVAL_DEV_GUILD_ID=

# Google Drive cold warehouse.
# Values are private deployment configuration. Never commit real folder IDs.
RIVAL_DRIVE_ROOT_FOLDER_ID=
RIVAL_DRIVE_HISTORY_FOLDER_ID=
RIVAL_DRIVE_MANIFESTS_FOLDER_ID=
RIVAL_DRIVE_MODELS_FOLDER_ID=
RIVAL_DRIVE_PREDICTIONS_FOLDER_ID=
RIVAL_DRIVE_BACKUPS_FOLDER_ID=
RIVAL_DRIVE_REPORTS_FOLDER_ID=
RIVAL_DRIVE_STAGING_FOLDER_ID=

# Runtime Google OAuth. Store real values only in deployment secret storage.
RIVAL_DRIVE_OAUTH_CLIENT_ID=
RIVAL_DRIVE_OAUTH_CLIENT_SECRET=
RIVAL_DRIVE_OAUTH_REFRESH_TOKEN=
RIVAL_ARCHIVE_ENABLED=false
RIVAL_ARCHIVE_LOCAL_DIR=data/archive-staging
RIVAL_ARCHIVE_CLOSED_STATE_MINUTES=60
RIVAL_ARCHIVE_BATCH_ROWS=25000
RIVAL_ARCHIVE_CHUNK_MIB=8
RIVAL_ARCHIVE_RUN_SECONDS=3600
RIVAL_ARCHIVE_MAX_BATCHES=4
