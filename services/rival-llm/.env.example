# Set in Discloud application environment, never commit real values.
RIVAL_LLM_SHARED_TOKEN=
RIVAL_LLM_PROFILE=lfm3
RIVAL_LLM_PORT=8765
RIVAL_LLAMA_SERVER_BIN=runtime/bin/llama-server

# Keep 4096 until Discloud memory and latency benchmarking proves 6144 safe.
RIVAL_LLM_CONTEXT_TOKENS=4096

# Dedicated Watch Yo Mouf token; must differ from the research token.
# This creates only the private TEXT classifier endpoint. No audio is received.
RIVAL_LLM_VOICE_ENABLED=false
RIVAL_LLM_VOICE_TOKEN=
